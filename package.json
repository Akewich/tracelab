{
  "name": "tracelab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:backend": "pnpm --filter @tracelab/backend dev",
    "build": "next build && pnpm --filter @tracelab/backend build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "next typegen && tsc --noEmit && pnpm --filter @tracelab/backend typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude backend/src/server.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:live": "node scripts/verify-live.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "test:e2e": "playwright test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.214.0",
    "@opentelemetry/core": "2.6.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.214.0",
    "@opentelemetry/instrumentation": "0.214.0",
    "@opentelemetry/resources": "2.6.1",
    "@opentelemetry/sdk-logs": "0.214.0",
    "@opentelemetry/sdk-metrics": "2.6.1",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@tracelab/shared": "workspace:*",
    "@vercel/otel": "2.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@opentelemetry/context-async-hooks": "2.6.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "4.1.12"
  }
}
